load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "block_test",
    size = "medium",
    srcs = ["block_test.py"],
    data = [
        "@acvp_aes_ecb_expected//file",
        "@acvp_aes_ecb_prompt//file",
        "@acvp_ml_kem_keygen_expected//file",
    ],
    deps = [
        "//enc_frx/aes:block",
        "//enc_frx/testing:kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# What the arithmetic S-box costs against the table it replaces. Not a test: a
# timing assertion is a flaky test, and the number belongs on the issue.
py_binary(
    name = "sbox_bench",
    testonly = True,
    srcs = ["sbox_bench.py"],
    deps = [
        "//enc_frx/aes:block",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# SP 800-38D §6.3's own algorithm, in plain Python — independent of the dtype the
# traced implementation uses.
py_library(
    name = "gcm_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "gcm_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

py_test(
    name = "ghash_test",
    size = "small",
    srcs = ["ghash_test.py"],
    deps = [
        ":gcm_reference",
        "//enc_frx/aes:ghash",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "ctr_test",
    size = "medium",
    srcs = ["ctr_test.py"],
    data = [
        "@acvp_aes_ctr_expected//file",
        "@acvp_aes_ctr_prompt//file",
    ],
    deps = [
        "//enc_frx/aes:block",
        "//enc_frx/aes:ctr",
        "//enc_frx/testing:kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Reaching CAVP's response files and picking batches out of them. Shared by the
# gate and the sweep, which run the same vectors at different depths.
py_library(
    name = "gcm_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "gcm_vectors.py",
    ],
    data = ["@cavp_aes_gcm//:vectors"],
    visibility = ["//enc_frx:__subpackages__"],
    deps = [
        "//enc_frx/testing:kat",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "gcm_test",
    size = "medium",
    srcs = ["gcm_test.py"],
    deps = [
        ":gcm_vectors",
        "//enc_frx:aead",
        "//enc_frx/aes:block",
        "//enc_frx/aes:ctr",
        "//enc_frx/aes:gcm",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The exhaustive pass: every one of CAVP's 47250 cases. Dropped from the per-PR
# run by .bazelrc.ci and put back by the scheduled one — `gcm_test` is what gates
# a merge.
py_test(
    name = "gcm_sweep_test",
    size = "enormous",
    srcs = ["gcm_sweep_test.py"],
    shard_count = 6,
    tags = ["slow_kat"],
    deps = [
        ":gcm_vectors",
        "//enc_frx/aes:gcm",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)
