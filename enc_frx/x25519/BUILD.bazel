load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

# X25519 (RFC 7748 §5): clamp, Montgomery ladder, public-key derivation, over
# the registered curve25519 field dtype.
py_library(
    name = "x25519",
    srcs = [
        "__init__.py",
        "x25519.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

# DHKEM(X25519, HKDF-SHA256) — RFC 9180 §4.1 over the Kem seam. HKDF and HMAC
# come from hash-frx; only the HPKE labeling lives here.
py_library(
    name = "dhkem",
    srcs = [
        "__init__.py",
        "dhkem.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":x25519",
        "//enc_frx:kem",
        "@hash_frx//hash_frx:hkdf",
        "@hash_frx//hash_frx:hmac",
        "@hash_frx//hash_frx:sha256",
        requirement("frx"),
        requirement("numpy"),
    ],
)
