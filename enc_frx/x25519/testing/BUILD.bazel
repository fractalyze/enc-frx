load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# RFC 7748 in exact Python integers — the oracle the traced code answers to.
py_library(
    name = "rfc7748_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "rfc7748_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

py_test(
    name = "field_test",
    size = "medium",
    srcs = ["field_test.py"],
    deps = [
        "//enc_frx/x25519:field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "x25519_test",
    size = "large",
    srcs = ["x25519_test.py"],
    deps = [
        ":rfc7748_reference",
        "//enc_frx/x25519",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
