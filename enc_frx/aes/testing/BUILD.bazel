load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "block_test",
    size = "medium",
    srcs = ["block_test.py"],
    data = [
        "@acvp_aes_ecb_expected//file",
        "@acvp_aes_ecb_prompt//file",
        "@acvp_ml_kem_keygen_expected//file",
    ],
    deps = [
        "//enc_frx/aes:block",
        "//enc_frx/testing:kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# What the arithmetic S-box costs against the table it replaces. Not a test: a
# timing assertion is a flaky test, and the number belongs on the issue.
py_binary(
    name = "sbox_bench",
    testonly = True,
    srcs = ["sbox_bench.py"],
    deps = [
        "//enc_frx/aes:block",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
