load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# RFC 8439 in exact Python integers — the oracle the traced code answers to.
py_library(
    name = "rfc8439_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "rfc8439_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

py_test(
    name = "chacha20_test",
    size = "medium",
    srcs = ["chacha20_test.py"],
    deps = [
        "//enc_frx/chacha:chacha20",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "poly1305_test",
    size = "small",
    srcs = ["poly1305_test.py"],
    deps = [
        ":rfc8439_reference",
        "//enc_frx/chacha:poly1305",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "chacha20_poly1305_test",
    size = "medium",
    srcs = ["chacha20_poly1305_test.py"],
    deps = [
        ":rfc8439_reference",
        "//enc_frx:aead",
        "//enc_frx/chacha:chacha20_poly1305",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "xchacha20_poly1305_test",
    size = "small",
    srcs = ["xchacha20_poly1305_test.py"],
    deps = [
        "//enc_frx:aead",
        "//enc_frx/chacha:chacha20",
        "//enc_frx/chacha:chacha20_poly1305",
        "//enc_frx/chacha:xchacha20_poly1305",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The hand-rolled 13-bit limb field against a registered field dtype over the
# same RFC 8439 polynomial — the numbers the layout decision is held to.
py_binary(
    name = "mac_bench",
    testonly = True,
    srcs = ["mac_bench.py"],
    deps = [
        ":rfc8439_reference",
        "//enc_frx/chacha:poly1305",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
