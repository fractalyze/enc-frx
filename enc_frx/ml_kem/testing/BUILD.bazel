load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# FIPS 203's NTT algorithms in exact Python integers — the oracle the traced
# code answers to.
py_library(
    name = "fips203_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "fips203_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

py_test(
    name = "ntt_test",
    size = "small",
    srcs = ["ntt_test.py"],
    deps = [
        ":fips203_reference",
        "//enc_frx/ml_kem:ntt",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
