"""enc-frx — FRX-native authenticated encryption and key encapsulation.

bzlmod module. bazel 9 dropped WORKSPACE support, so dependencies and the
hermetic Python toolchain are declared here rather than in WORKSPACE.bazel.
"""

module(
    name = "enc_frx",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# The version MVS resolves anyway — protobuf, in rules_python's own dependency
# graph, requires it. Declaring the lower version only adds a
# direct-dependency-mismatch warning to every invocation.
bazel_dep(name = "rules_python", version = "1.7.0")

# The symmetric layer this repo hashes through: SHAKE for ML-KEM's sampling,
# SHA-3 for its G/H/J functions. It rides the bzlmod module graph pinned to a
# commit rather than the pip lock, because a commit pin is exact, needs no
# package index, and exposes `@hash_frx//hash_frx:...` targets directly.
#
# The cost is a second pip hub — hash-frx resolves frx from its own lock — so the
# two locks pin the same frx build (see //:requirements.in). Skew there puts two
# different frx copies on one test's sys.path.
#
# To build against a local hash-frx checkout instead of the pin:
#   echo 'common --override_module=hash_frx=/abs/path/to/hash-frx' >> .bazelrc.user
bazel_dep(name = "hash_frx", version = "0.0.0")
git_override(
    module_name = "hash_frx",
    commit = "7313e13079afbf585a232e22986d184f8f5e89eb",
    remote = "https://github.com/fractalyze/hash-frx.git",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # frx / frxlib / frx-cuda12-pjrt / frx-cuda12-plugin are published on the
    # Fractalyze index.
    extra_pip_args = ["--extra-index-url=https://fractalyze.github.io/pypi/simple/"],
    hub_name = "enc_frx_pip",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock_3_11.txt",
)
use_repo(pip, "enc_frx_pip")

# Known-answer vectors are fetched and pinned, never committed. The published
# sets run to hundreds of kilobytes today and grow with every parameter set,
# which is a permanent tax on every clone for data that never changes after
# publication. `http_file` pins content by sha256, so a corrupted or swapped
# fetch fails the build, and the repository cache makes every build after the
# first offline.
#
# The URLs are pinned to one ACVP-Server commit rather than a branch: NIST
# regenerates these files, and a moving URL would turn a vector regeneration
# upstream into a mystery failure here.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The ACVP JSON split: prompt.json carries the inputs, expectedResults.json the
# outputs, joined on (tgId, tcId). Both halves are needed for one vector set.
#
# These are generated against the final standard, which the CCTV sets below are
# not, so the keyGen set is the one thing here that gates `(d, z) -> (ek, dk)`
# end to end.
http_file(
    name = "acvp_ml_kem_keygen_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "3f9ce34f6c836c77958bad2729e837c3b213f44ac36c3065976e7acca6389523",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-KEM-keyGen-FIPS203/prompt.json"],
)

http_file(
    name = "acvp_ml_kem_keygen_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "a253d0ad91c95ebea5b409673defef0aa49d65d4ed72286399e2e798ddf073a4",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-KEM-keyGen-FIPS203/expectedResults.json"],
)

# The encapDecap set carries four functions, not two. Beyond encapsulation and
# decapsulation it publishes `encapsulationKeyCheck` and `decapsulationKeyCheck`
# — the §7.2 and §7.3 input validation — which are the only groups here with a
# published verdict. The decapsulation cases carry none, because under implicit
# rejection a modified ciphertext yields a shared secret rather than a failure.
http_file(
    name = "acvp_ml_kem_encapdecap_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "998e22dfb12efb14ce9fdff911ca634b13612819a1806f25da69adba7e16db91",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-KEM-encapDecap-FIPS203/prompt.json"],
)

http_file(
    name = "acvp_ml_kem_encapdecap_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "9089ec6ff2424da9f2782b89b2f831a329a3e28d6e5e24b802b78ff36ac61cdf",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ML-KEM-encapDecap-FIPS203/expectedResults.json"],
)

# ACVP's AES-ECB set gates the block cipher. It publishes both directions and a
# Monte Carlo test type alongside the single-block one; this repo implements
# encryption only, so the loader keeps all four and the test refuses what it
# cannot run — a filtered load could not tell the difference between absent and
# unsupported.
http_file(
    name = "acvp_aes_ecb_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "b4ec2a6e7011a9d7fb453aef52b32872cc7509dda07b13b28237d9b8f56076e9",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ACVP-AES-ECB-1.0/prompt.json"],
)

http_file(
    name = "acvp_aes_ecb_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "4893c2718529d4af5a10f10335118e5a462808a0857005440c52b1083d71da18",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ACVP-AES-ECB-1.0/expectedResults.json"],
)

# ACVP's AES-CTR set. Its expected results carry the counter block the
# implementation chose, so a case is `(key, iv, pt) -> ct` rather than the
# prompt alone.
http_file(
    name = "acvp_aes_ctr_prompt",
    downloaded_file_path = "prompt.json",
    sha256 = "35bdaf6ba04315aa28637efd22c61a3c34bed426d4bf5a3b2ae8069fca2b9cec",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ACVP-AES-CTR-1.0/prompt.json"],
)

http_file(
    name = "acvp_aes_ctr_expected",
    downloaded_file_path = "expectedResults.json",
    sha256 = "3b6a8aabcc230c8277fa638814353f702a4d2f320a0a60ad3f078fc94bb83e7e",
    urls = ["https://raw.githubusercontent.com/usnistgov/ACVP-Server/ad33b3d9504491767f1aa76382464f3b3fa2359e/gen-val/json-files/ACVP-AES-CTR-1.0/expectedResults.json"],
)

# CAVP's GCM vectors, which gate AES-GCM. An archive rather than the `http_file`
# every other set uses, because NIST publishes these as one zip of six response
# files — three key lengths, each with an encrypt and a decrypt set.
#
# CAVP rather than ACVP's `ACVP-AES-GCM-1.0`, for two reasons that only show up
# on inspection. That set is AES-128 alone, so it cannot gate the other two key
# lengths at all. And ACVP measures a payload in *bits*: its CTR set is mostly
# not a whole number of bytes, which CTR absorbs with a documented mask and GCM
# could not, since the tag covers the ciphertext and a masked ciphertext is a
# different computation rather than a different encoding. Every CAVP length —
# payload, associated data, IV, and tag — is a whole number of bytes, so the
# question does not arise.
#
# The set is also the negative gate: the decrypt files publish 11908 cases whose
# expected result is `FAIL`, covering shapes hand-written corruption would not
# think of.
#
# There is no commit to pin to, so the sha256 carries the whole weight here. That
# is sound for this file in a way it would not be for a moving branch: CAVS
# generated it in 2012 and CAVP does not regenerate its legacy sets.
http_archive(
    name = "cavp_aes_gcm",
    build_file_content = """filegroup(
    name = "vectors",
    srcs = glob(["*.rsp"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "f9fc479e134cde2980b3bb7cddbcb567b2cd96fd753835243ed067699f26a023",
    urls = ["https://csrc.nist.gov/CSRC/media/Projects/Cryptographic-Algorithm-Validation-Program/documents/mac/gcmtestvectors.zip"],
)

# C2SP's CCTV collection, which gates the §4.2.2 samplers. ACVP cannot: it
# publishes `(d, z) -> (ek, dk)` and nothing between, so it gates `SampleNTT`
# and `SamplePolyCBD` only as far as a whole key generation gates every step
# inside it — which means not at all until K-PKE lands, and then only jointly.
# CCTV's `intermediate/` files publish `ρ`, `σ`, the matrix `Â` and the secret
# and error vectors as separate labelled values, so each sampler is pinned on
# its own.
#
# One file per parameter set, and all three are needed rather than one: `η1` is
# 3 for ML-KEM-512 and 2 for the other two, so a single file gates one of the
# two centered-binomial widths and silently skips the other.
#
# Pinned to a commit that predates the final standard in one line — these sets
# expand `(ρ, σ) ← G(d)`, not `G(d ‖ k)` — which `docs/schemes/ml-kem.md`
# explains and key generation is gated around: they enter below the expansion,
# at `_key_pair`. The expansion itself is ACVP's to gate, since its sets are
# generated against the final standard. Moving this pin to a regenerated CCTV
# set would let these files drive key generation from `d` as well; it would not
# uncover anything the ACVP sets do not already gate.
CCTV_COMMIT = "1e3d2860d46e94e777e1b17c7a6f2436387e3ecc"

http_file(
    name = "cctv_ml_kem_intermediate_512",
    downloaded_file_path = "ML-KEM-512.txt",
    sha256 = "3cb7a5c2421d4ada68f61b9c26e6136a3436c320e0c016af7095dadb41217bf1",
    urls = ["https://raw.githubusercontent.com/C2SP/CCTV/" + CCTV_COMMIT + "/ML-KEM/intermediate/ML-KEM-512.txt"],
)

http_file(
    name = "cctv_ml_kem_intermediate_768",
    downloaded_file_path = "ML-KEM-768.txt",
    sha256 = "4cdeed48a917ec2825a49a03815c31692d51b4be0b6850a0abc56cb39bab1f84",
    urls = ["https://raw.githubusercontent.com/C2SP/CCTV/" + CCTV_COMMIT + "/ML-KEM/intermediate/ML-KEM-768.txt"],
)

http_file(
    name = "cctv_ml_kem_intermediate_1024",
    downloaded_file_path = "ML-KEM-1024.txt",
    sha256 = "af15ceb9c7129a152e0a9d66caabe0567b566b949bacfe8349c6a3c4b46cb64a",
    urls = ["https://raw.githubusercontent.com/C2SP/CCTV/" + CCTV_COMMIT + "/ML-KEM/intermediate/ML-KEM-1024.txt"],
)

# The `unluckysample` sets: seeds found by search whose `SampleNTT` rejects far
# more than average, needing 576 bytes of SHAKE128 where the mean is 315
# candidates worth. They are the only published vectors that can tell a fixed
# XOF budget is too small — every ordinary vector fits in three blocks, so a
# three-block implementation passes the entire rest of the corpus and fails
# here. See `sampling.py` for how the budget is chosen.
http_file(
    name = "cctv_ml_kem_unlucky_512",
    downloaded_file_path = "ML-KEM-512.txt",
    sha256 = "9d4e0ae011978a8f88a49b755ea6996a693428aaea0477c84331580c15b77a9b",
    urls = ["https://raw.githubusercontent.com/C2SP/CCTV/" + CCTV_COMMIT + "/ML-KEM/unluckysample/ML-KEM-512.txt"],
)

http_file(
    name = "cctv_ml_kem_unlucky_768",
    downloaded_file_path = "ML-KEM-768.txt",
    sha256 = "fede6f787581dc708e5c3337d7e49de33333d23023470668cd0588b65ad0ba90",
    urls = ["https://raw.githubusercontent.com/C2SP/CCTV/" + CCTV_COMMIT + "/ML-KEM/unluckysample/ML-KEM-768.txt"],
)

http_file(
    name = "cctv_ml_kem_unlucky_1024",
    downloaded_file_path = "ML-KEM-1024.txt",
    sha256 = "8da6cdb2fb0d4e2223dfa5229ec97d4ded7b93bd8b2202e9a7533850c817b8cd",
