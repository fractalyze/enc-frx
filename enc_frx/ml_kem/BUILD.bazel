load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "params",
    srcs = [
        "__init__.py",
        "params.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "ntt",
    srcs = [
        "__init__.py",
        "ntt.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The package's whole hash surface. Every scheme-level hash reaches Keccak
# through @hash_frx's ByteHash seam, so a second copy of SHA-3 cannot appear
# here, and no sibling target needs its own hash dependency.
py_library(
    name = "hashes",
    srcs = [
        "__init__.py",
        "hashes.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        "@hash_frx//hash_frx",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "sampling",
    srcs = [
        "__init__.py",
        "sampling.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":encoding",
        ":hashes",
        ":ntt",
        ":params",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Not public: K-PKE is IND-CPA only, so only ML-KEM itself and this package's
# tests may depend on it. The underscored name carries the same intent into the
# wheel, which the visibility cannot reach — see `_k_pke.py`'s module docstring.
py_library(
    name = "_k_pke",
    srcs = [
        "__init__.py",
        "_k_pke.py",
    ],
    visibility = ["//enc_frx/ml_kem:__subpackages__"],
    deps = [
        ":encoding",
        ":hashes",
        ":ntt",
        ":params",
        ":sampling",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# ML-KEM itself: the FO transform over K-PKE, and the only IND-CCA2 thing in the
# package. Public, where `_k_pke` beneath it is not.
py_library(
    name = "ml_kem",
    srcs = [
        "__init__.py",
        "ml_kem.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":_k_pke",
        ":encoding",
        ":hashes",
        ":params",
        "//enc_frx:kem",
        requirement("frx"),
    ],
)
