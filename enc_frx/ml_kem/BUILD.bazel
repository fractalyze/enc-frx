load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "params",
    srcs = [
        "__init__.py",
        "params.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "ntt",
    srcs = [
        "__init__.py",
        "ntt.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "encoding",
    srcs = [
        "__init__.py",
        "encoding.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# The only target that names Keccak. Every scheme-level hash reaches it through
# @hash_frx's ByteHash seam, so a second copy of SHA-3 cannot appear here.
py_library(
    name = "hashes",
    srcs = [
        "__init__.py",
        "hashes.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":params",
        "@hash_frx//hash_frx/keccak",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "sampling",
    srcs = [
        "__init__.py",
        "sampling.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":encoding",
        ":hashes",
        ":ntt",
        ":params",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# Not public: K-PKE is IND-CPA only, so only ML-KEM itself and this package's
# tests may depend on it. What that does and does not fence is in `k_pke.py`'s
# module docstring.
py_library(
    name = "k_pke",
    srcs = [
        "__init__.py",
        "k_pke.py",
    ],
    visibility = ["//enc_frx/ml_kem:__subpackages__"],
    deps = [
        ":encoding",
        ":hashes",
        ":ntt",
        ":params",
        ":sampling",
        requirement("frx"),
        requirement("numpy"),
    ],
)
