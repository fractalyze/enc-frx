load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# FIPS 203's NTT algorithms in exact Python integers — the oracle the traced
# code answers to.
py_library(
    name = "fips203_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "fips203_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

py_test(
    name = "ntt_test",
    size = "small",
    srcs = ["ntt_test.py"],
    deps = [
        ":fips203_reference",
        "//enc_frx/ml_kem:ntt",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "encoding_test",
    size = "medium",
    srcs = ["encoding_test.py"],
    deps = [
        ":fips203_reference",
        "//enc_frx/ml_kem:encoding",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# C2SP's CCTV vectors: the intermediate values that pin each sampler on its own,
# and the unlucky seeds that pin the XOF budget.
#
# The files ride on this target rather than on each test, because this is what
# knows their names — a consumer asks for a parameter set. A test that added an
# accessor and forgot a `data` entry would fail on a missing runfile instead.
py_library(
    name = "cctv_vectors",
    testonly = True,
    srcs = [
        "__init__.py",
        "cctv_vectors.py",
    ],
    data = [
        "@cctv_ml_kem_intermediate_1024//file",
        "@cctv_ml_kem_intermediate_512//file",
        "@cctv_ml_kem_intermediate_768//file",
        "@cctv_ml_kem_unlucky_1024//file",
        "@cctv_ml_kem_unlucky_512//file",
        "@cctv_ml_kem_unlucky_768//file",
    ],
    visibility = ["//enc_frx:__subpackages__"],
    deps = [
        "//enc_frx/ml_kem:encoding",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

py_test(
    name = "sampling_test",
    size = "medium",
    srcs = ["sampling_test.py"],
    deps = [
        ":cctv_vectors",
        ":fips203_reference",
        "//enc_frx/ml_kem:hashes",
        "//enc_frx/ml_kem:ntt",
        "//enc_frx/ml_kem:params",
        "//enc_frx/ml_kem:sampling",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# K-PKE assembled: the published intermediate values at every stage, and the
# round trips that cover the space between the three points they pin.
py_test(
    name = "_k_pke_test",
    size = "medium",
    srcs = ["_k_pke_test.py"],
    deps = [
        ":cctv_vectors",
        "//enc_frx/ml_kem:_k_pke",
        "//enc_frx/ml_kem:ntt",
        "//enc_frx/ml_kem:params",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The transform assembled: CCTV's published run at every parameter set, and the
# rejection path, which no positive vector reaches.
py_test(
    name = "ml_kem_test",
    size = "medium",
    srcs = ["ml_kem_test.py"],
    deps = [
        ":cctv_vectors",
        "//enc_frx:kem",
        "//enc_frx/ml_kem",
        "//enc_frx/ml_kem:_k_pke",
        "//enc_frx/ml_kem:encoding",
        "//enc_frx/ml_kem:params",
        "//enc_frx/testing:kat",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
