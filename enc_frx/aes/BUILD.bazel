load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "block",
    srcs = [
        "__init__.py",
        "block.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "ghash",
    srcs = [
        "__init__.py",
        "ghash.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":block",
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "ctr",
    srcs = [
        "__init__.py",
        "ctr.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":block",
        ":ghash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "gcm",
    srcs = [
        "__init__.py",
        "gcm.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":block",
        ":ctr",
        ":ghash",
        "//enc_frx:aead",
        requirement("frx"),
    ],
)

# POLYVAL (RFC 8452 §3) — GHASH's little-endian sibling, computed through the
# Appendix A identity over the same field dtype.
py_library(
    name = "polyval",
    srcs = [
        "__init__.py",
        "polyval.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ghash",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# AES-GCM-SIV (RFC 8452) — the nonce-misuse-resistant Aead.
py_library(
    name = "gcm_siv",
    srcs = [
        "__init__.py",
        "gcm_siv.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":block",
        ":polyval",
        "//enc_frx:aead",
        requirement("frx"),
        requirement("numpy"),
    ],
)

# AES-CCM (SP 800-38C / RFC 3610) — CTR + CBC-MAC behind the Aead seam.
py_library(
    name = "ccm",
    srcs = [
        "__init__.py",
        "ccm.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":block",
        "//enc_frx:aead",
        requirement("frx"),
        requirement("numpy"),
    ],
)
