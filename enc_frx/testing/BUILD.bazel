load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//enc_frx",
        requirement("absl_py"),
    ],
)

# The hash-frx wiring guard: the only target that reaches across the module pin
# into @hash_frx, so a broken dependency fails here rather than inside a scheme.
py_test(
    name = "hash_frx_dep_test",
    size = "small",
    srcs = ["hash_frx_dep_test.py"],
    deps = [
        "@hash_frx//hash_frx",
        "@hash_frx//hash_frx:byte_hash",
        "@hash_frx//hash_frx:sha256",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The dtype-floor guard: AES-GCM's two fields are native here, and the pin that
# makes them so is a direct one for this reason.
py_test(
    name = "binary_fields_test",
    size = "small",
    srcs = ["binary_fields_test.py"],
    deps = [
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
