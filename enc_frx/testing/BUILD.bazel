load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//enc_frx",
        requirement("absl_py"),
    ],
)

# The hash-frx wiring guard: the only target that reaches across the module pin
# into @hash_frx, so a broken dependency fails here rather than inside a scheme.
py_test(
    name = "hash_frx_dep_test",
    size = "small",
    srcs = ["hash_frx_dep_test.py"],
    deps = [
        "@hash_frx//hash_frx",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The dtype-floor guard: AES-GCM's two fields are native here, and the pin that
# makes them so is a direct one for this reason.
py_test(
    name = "binary_fields_test",
    size = "small",
    srcs = ["binary_fields_test.py"],
    deps = [
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The stand-ins every seam- and harness-level test drives. Not real schemes; see
# their docstrings.
py_library(
    name = "toy_kem",
    testonly = True,
    srcs = [
        "__init__.py",
        "toy_kem.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
    deps = [
        "//enc_frx:kem",
        requirement("frx"),
    ],
)

py_library(
    name = "toy_aead",
    testonly = True,
    srcs = [
        "__init__.py",
        "toy_aead.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
    deps = [
        "//enc_frx:aead",
        requirement("frx"),
    ],
)

py_test(
    name = "kem_test",
    size = "small",
    srcs = ["kem_test.py"],
    deps = [
        ":toy_kem",
        "//enc_frx:kem",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "aead_test",
    size = "small",
    srcs = ["aead_test.py"],
    deps = [
        ":toy_aead",
        "//enc_frx:aead",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# The known-answer harness. testonly, and deliberately not part of the shipped
# package: a consumer runs schemes, not their gate.
py_library(
    name = "kat",
    testonly = True,
    srcs = [
        "__init__.py",
        "kat.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
    deps = [
        "//enc_frx:aead",
        "//enc_frx:kem",
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_test(
    name = "kat_test",
    size = "small",
    srcs = ["kat_test.py"],
    deps = [
        ":kat",
        ":toy_aead",
        ":toy_kem",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# Runs the loader over NIST's published files, fetched and sha256-pinned in
# //MODULE.bazel rather than committed.
py_test(
    name = "acvp_vectors_test",
    size = "small",
    srcs = ["acvp_vectors_test.py"],
    data = [
        "@acvp_ml_kem_encapdecap_expected//file",
        "@acvp_ml_kem_encapdecap_prompt//file",
        "@acvp_ml_kem_keygen_expected//file",
        "@acvp_ml_kem_keygen_prompt//file",
    ],
    deps = [
        ":kat",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)
