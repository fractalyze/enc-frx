load("@enc_frx_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# RFC 7748 in exact Python integers — the oracle the traced code answers to.
py_library(
    name = "rfc7748_reference",
    testonly = True,
    srcs = [
        "__init__.py",
        "rfc7748_reference.py",
    ],
    visibility = ["//enc_frx:__subpackages__"],
)

# DHKEM against RFC 9180's published corpus, fetched and sha256-pinned in
# //MODULE.bazel rather than committed.
py_test(
    name = "dhkem_test",
    size = "medium",
    srcs = ["dhkem_test.py"],
    data = ["@hpke_test_vectors//file"],
    deps = [
        "//enc_frx:kem",
        "//enc_frx/testing:kat",
        "//enc_frx/x25519:dhkem",
        "@rules_python//python/runfiles",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "x25519_test",
    size = "medium",
    srcs = ["x25519_test.py"],
    deps = [
        ":rfc7748_reference",
        "//enc_frx/x25519",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

# What the traced byte boundary costs: the shipped path against host-entered
# Montgomery material, one shared ladder body (see the module docstring).
py_binary(
    name = "ladder_bench",
    testonly = True,
    srcs = ["ladder_bench.py"],
    deps = [
        ":rfc7748_reference",
        "//enc_frx/x25519",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)
